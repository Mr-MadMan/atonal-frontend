{
  "compilerOptions": {
    "target": "es2015",
    "module": "esnext",
    "lib": ["esnext", "dom"],
    "allowJs": true,
    "checkJs": false,          // 已关闭 JS 类型检查
    "noImplicitAny": false,    // 允许隐式 any 类型
    "strict": false,           // 显式关闭所有严格类型检查
    "isolatedModules": false,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "skipLibCheck": true,      // 跳过库类型检查
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "jsx": "preserve",
    "noEmit": true,
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx", "**/*.vue"],
  "exclude": ["node_modules"]  // 建议添加排除目录
}